---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>{SITE_TITLE}</h1>
				<p class="tagline">{SITE_DESCRIPTION}</p>
				<p>
					I'm a software engineer building an indie game in <a href="https://godotengine.org/">Godot</a>.
					This is where I write about the wins, the bugs, the rewrites, and everything else along the way.
				</p>
				<p>
					<a href="/blog" class="cta">Read the latest posts →</a>
				</p>
			</section>

			{latest.length > 0 && (
				<section class="latest">
					<h2>Latest posts</h2>
					<ul>
						{latest.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="post-title">{post.data.title}</span>
									<FormattedDate date={post.data.pubDate} />
								</a>
							</li>
						))}
					</ul>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 1rem 0 2rem;
	}
	.hero h1 {
		margin-bottom: 0.25rem;
	}
	.tagline {
		color: rgb(var(--gray));
		font-size: 1.15rem;
		margin-top: 0;
	}
	.cta {
		font-weight: 600;
	}
	.latest {
		border-top: 1px solid rgb(var(--gray-light));
		padding-top: 1.5rem;
	}
	.latest ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.latest li {
		margin-bottom: 0.75rem;
	}
	.latest li a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		text-decoration: none;
		color: inherit;
		border-bottom: 1px solid transparent;
	}
	.latest li a:hover {
		border-bottom-color: var(--accent);
	}
	.post-title {
		font-weight: 600;
	}
</style>
